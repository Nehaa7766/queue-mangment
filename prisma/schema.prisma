// Data model from docs/PLAN.md §8.
// The connection URL lives in prisma.config.ts.
//
// Lines marked "Assumption:" are working defaults until Phase 0 confirms them
// with the pilot clinic (docs/PLAN.md §19).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// Assumption: one role per user per clinic.
enum MembershipRole {
  RECEPTIONIST
  DOCTOR
  CLINIC_ADMIN
}

// Platform staff only; kept on User, separate from clinic memberships.
enum PlatformRole {
  SUPER_ADMIN
}

enum ClinicStatus {
  ACTIVE
  INACTIVE
}

// Kind of practice, shown on the clinic profile.
enum ClinicType {
  GENERAL
  DENTAL
  PEDIATRIC
  GYNECOLOGY
  ORTHOPEDIC
  DERMATOLOGY
  ENT
  EYE
  MULTI_SPECIALTY
  DIAGNOSTIC
  OTHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  INVITED
  ACTIVE
  INACTIVE
}

enum QueueStatus {
  OPEN
  PAUSED
  CLOSED
}

// Allowed transitions live in src/features/queue (docs/PLAN.md §9).
enum TokenStatus {
  WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  SKIPPED
  CANCELLED
}

// What happens when the grace period runs out on a called token.
enum NoShowAction {
  SKIP
  REQUEUE
}

// Set by doctors (Phase 6); shown to reception and patients.
enum DoctorAvailability {
  AVAILABLE
  ON_BREAK
  OFF_DUTY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// ---------------------------------------------------------------------------
// Tenancy and people
// ---------------------------------------------------------------------------

// Queue settings sit on Clinic rather than a 1:1 ClinicSettings model: they
// are always read with the clinic, so a separate row only adds a join.
model Clinic {
  id           String       @id @default(uuid(7)) @db.Uuid
  name         String
  slug         String       @unique
  // IANA name; queue days are computed in this timezone.
  timezone     String       @default("Asia/Kolkata")
  clinicType   ClinicType   @default(GENERAL) @map("clinic_type")
  // Official contact email, shown to staff; not used for sign-in.
  email        String?
  phone        String?
  // Street address; city, state and PIN code are separate for search and
  // display (Indian addresses: PIN is 6 digits).
  address      String?
  city         String?
  state        String?
  pinCode      String?      @map("pin_code") @db.VarChar(6)
  // Weekly hours, e.g. { "mon": [["09:00", "13:00"]] }. Edited in Phase 7.
  openingHours Json?        @map("opening_hours")
  status       ClinicStatus @default(ACTIVE)

  // Assumption: one wait target for the whole clinic, not per service.
  waitTargetMinutes        Int          @default(20) @map("wait_target_minutes")
  // Assumption: 5 minutes for a called patient to arrive.
  gracePeriodSeconds       Int          @default(300) @map("grace_period_seconds")
  // Null means no limit.
  maxQueueSize             Int?         @map("max_queue_size")
  noShowAction             NoShowAction @default(SKIP) @map("no_show_action")
  // Whether a skipped patient may be put back in the queue.
  allowRequeue             Boolean      @default(true) @map("allow_requeue")
  // Assumption until a retention policy is agreed (Phase 9): patient names
  // are cleared this many days after the visit.
  patientDataRetentionDays Int          @default(30) @map("patient_data_retention_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships    ClinicMembership[]
  services       Service[]
  queues         Queue[]
  tokens         QueueToken[]
  auditEvents    AuditEvent[]
  holidays       ClinicHoliday[]
  invitations    StaffInvitation[]
  subscription   Subscription?
  supportTickets SupportTicket[]
  logo           ClinicLogo?
  conversations  Conversation[]
  messages       Message[]
  broadcasts     Broadcast[]

  @@map("clinics")
}

// A clinic's logo, kept in the database so small servers need no file
// storage. PNG, JPEG or WebP, at most 512 KB (src/features/clinics/logo.ts).
// Served at /api/public/clinics/[clinicSlug]/logo.
model ClinicLogo {
  clinicId    String   @id @map("clinic_id") @db.Uuid
  contentType String   @map("content_type")
  data        Bytes
  updatedAt   DateTime @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("clinic_logos")
}

// Staff and platform users only. Patients have no account in the MVP.
// Also Better Auth's user model (src/lib/auth/auth.ts); passwords live in Account.
model User {
  id            String        @id @default(uuid(7)) @db.Uuid
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false) @map("email_verified")
  image         String?
  platformRole  PlatformRole? @map("platform_role")
  status        UserStatus    @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions       Session[]
  accounts       Account[]
  memberships    ClinicMembership[]
  assignedTokens QueueToken[]       @relation("AssignedDoctor")
  createdTokens  QueueToken[]       @relation("CreatedBy")
  auditEvents    AuditEvent[]

  sentInvitations     StaffInvitation[]    @relation("InvitedBy")
  supportTickets      SupportTicket[]
  platformAuditEvents PlatformAuditEvent[]
  sentMessages        Message[]
  broadcasts          Broadcast[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Authentication (Better Auth). Field names follow Better Auth's defaults.
// ---------------------------------------------------------------------------

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  // Opaque session token stored in the cookie.
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// One row per sign-in method. Email and password uses providerId "credential",
// with the password hash in `password`.
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// Short-lived values such as password reset tokens.
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model ClinicMembership {
  id       String           @id @default(uuid(7)) @db.Uuid
  clinicId String           @map("clinic_id") @db.Uuid
  userId   String           @map("user_id") @db.Uuid
  role     MembershipRole
  status   MembershipStatus @default(ACTIVE)

  // Doctors only (Phase 6).
  availability          DoctorAvailability @default(AVAILABLE)
  // Extra delay the doctor announces, in minutes.
  delayMinutes          Int                @default(0) @map("delay_minutes")
  availabilityNote      String?            @map("availability_note") @db.VarChar(120)
  availabilityUpdatedAt DateTime?          @map("availability_updated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic             Clinic              @relation(fields: [clinicId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  serviceAssignments ServiceAssignment[]

  @@unique([clinicId, userId])
  @@index([userId])
  @@map("clinic_memberships")
}

// ---------------------------------------------------------------------------
// Services and queues
// ---------------------------------------------------------------------------

model Service {
  id                       String  @id @default(uuid(7)) @db.Uuid
  clinicId                 String  @map("clinic_id") @db.Uuid
  name                     String
  description              String?
  // First part of the display label, e.g. "A" in "A-17".
  tokenPrefix              String  @map("token_prefix") @db.VarChar(4)
  estimatedDurationMinutes Int     @default(10) @map("estimated_duration_minutes")
  // Soft-disable keeps past tokens and analytics intact.
  isActive                 Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic      Clinic              @relation(fields: [clinicId], references: [id])
  queues      Queue[]
  tokens      QueueToken[]
  assignments ServiceAssignment[]

  @@unique([clinicId, name])
  @@unique([clinicId, tokenPrefix])
  @@map("services")
}

// Assumption: one queue per service per clinic day, shared by every doctor
// on that service. Sequence numbers restart each day with the new row.
model Queue {
  id           String      @id @default(uuid(7)) @db.Uuid
  clinicId     String      @map("clinic_id") @db.Uuid
  serviceId    String      @map("service_id") @db.Uuid
  // Calendar day in the clinic's timezone, not UTC.
  queueDate    DateTime    @map("queue_date") @db.Date
  status       QueueStatus @default(OPEN)
  // Atomic counter for sequenceNumber and sortKey. Allocate with
  // UPDATE ... SET next_sequence = next_sequence + 1 RETURNING.
  nextSequence Int         @default(1) @map("next_sequence")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic      Clinic       @relation(fields: [clinicId], references: [id])
  service     Service      @relation(fields: [serviceId], references: [id])
  tokens      QueueToken[]
  auditEvents AuditEvent[]

  @@unique([serviceId, queueDate])
  @@index([clinicId, queueDate])
  @@map("queues")
}

model QueueToken {
  id             String      @id @default(uuid(7)) @db.Uuid
  // Used in the patient's status URL. v4 is fully random; v7 would expose
  // the creation time and be partly guessable.
  publicTokenId  String      @unique @default(uuid(4)) @map("public_token_id")
  queueId        String      @map("queue_id") @db.Uuid
  // Copied from the queue so tenant checks don't need a join.
  clinicId       String      @map("clinic_id") @db.Uuid
  serviceId      String      @map("service_id") @db.Uuid
  // Never changes; the source of tokenLabel.
  sequenceNumber Int         @map("sequence_number")
  // FIFO order. Equals sequenceNumber at join; a requeue takes a fresh value
  // from the same counter so the token moves to the end.
  sortKey        Int         @map("sort_key")
  tokenLabel     String      @map("token_label") @db.VarChar(16)
  // Assumption: optional first name or initials only; no phone in the MVP.
  patientName    String?     @map("patient_name") @db.VarChar(80)
  status         TokenStatus @default(WAITING)
  recallCount    Int         @default(0) @map("recall_count")

  // Assumption: doctors share the service queue; this records who serves it.
  assignedDoctorId String? @map("assigned_doctor_id") @db.Uuid
  // Null for patient self-service joins.
  createdByUserId  String? @map("created_by_user_id") @db.Uuid

  joinedAt         DateTime  @default(now()) @map("joined_at")
  calledAt         DateTime? @map("called_at")
  serviceStartedAt DateTime? @map("service_started_at")
  completedAt      DateTime? @map("completed_at")
  skippedAt        DateTime? @map("skipped_at")
  cancelledAt      DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  queue               Queue                @relation(fields: [queueId], references: [id])
  clinic              Clinic               @relation(fields: [clinicId], references: [id])
  service             Service              @relation(fields: [serviceId], references: [id])
  assignedDoctor      User?                @relation("AssignedDoctor", fields: [assignedDoctorId], references: [id])
  createdBy           User?                @relation("CreatedBy", fields: [createdByUserId], references: [id])
  auditEvents         AuditEvent[]
  conversations       Conversation[]
  broadcastRecipients BroadcastRecipient[]

  @@unique([queueId, sequenceNumber])
  @@index([queueId, status, sortKey])
  @@index([clinicId, createdAt])
  @@index([assignedDoctorId, status])
  @@map("queue_tokens")
}

// ---------------------------------------------------------------------------
// Audit, outbox, idempotency
// ---------------------------------------------------------------------------

// Append-only. Links are cleared, not cascaded, so history survives deletes.
model AuditEvent {
  id            String   @id @default(uuid(7)) @db.Uuid
  clinicId      String   @map("clinic_id") @db.Uuid
  queueId       String?  @map("queue_id") @db.Uuid
  tokenId       String?  @map("token_id") @db.Uuid
  // Null for patient self-service or system actions.
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  // Dotted verb, e.g. "token.called", "queue.paused".
  action        String
  previousState String?  @map("previous_state")
  newState      String?  @map("new_state")
  // Keep small; no patient details beyond what the token already holds.
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  clinic Clinic      @relation(fields: [clinicId], references: [id])
  queue  Queue?      @relation(fields: [queueId], references: [id], onDelete: SetNull)
  token  QueueToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  actor  User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
  @@index([tokenId])
  @@map("audit_events")
}

// Written in the same transaction as the action; sent later by a worker (Phase 8).
model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  eventType     String    @map("event_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at")
  processedAt   DateTime? @map("processed_at")
  attemptCount  Int       @default(0) @map("attempt_count")
  // Sanitized: no secrets or patient details.
  lastError     String?   @map("last_error")
  // Earliest time the worker may try again; pushed back after each failure.
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  // Set when retries run out; someone needs to look at the event.
  failedAt      DateTime? @map("failed_at")

  @@index([processedAt, createdAt])
  @@index([processedAt, failedAt, nextAttemptAt])
  @@map("outbox_events")
}

// Lets a retried request return the original result instead of acting twice.
model IdempotencyRecord {
  id                 String   @id @default(uuid(7)) @db.Uuid
  // e.g. "queue:<queueId>:join" — keys only collide within one scope.
  scope              String
  idempotencyKey     String   @map("idempotency_key") @db.VarChar(128)
  // sha256 of the canonical request body.
  requestFingerprint String   @map("request_fingerprint") @db.Char(64)
  // ID of what the original request created, e.g. a QueueToken id.
  responseReference  String   @map("response_reference")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([scope, idempotencyKey])
  @@map("idempotency_records")
}

// ---------------------------------------------------------------------------
// Clinic setup (Phases 6–7)
// ---------------------------------------------------------------------------

// Which services a doctor serves. Set by clinic admins (Phase 7).
// Assumption: a doctor with no assignments may serve every service.
model ServiceAssignment {
  id           String   @id @default(uuid(7)) @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  serviceId    String   @map("service_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  membership ClinicMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  service    Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([membershipId, serviceId])
  @@index([serviceId])
  @@map("service_assignments")
}

// Days the clinic is closed, in the clinic's timezone.
model ClinicHoliday {
  id        String   @id @default(uuid(7)) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  date      DateTime @db.Date
  name      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, date])
  @@map("clinic_holidays")
}

// The invitation link carries a random token; only its SHA-256 hash is stored.
model StaffInvitation {
  id              String         @id @default(uuid(7)) @db.Uuid
  clinicId        String         @map("clinic_id") @db.Uuid
  email           String
  name            String
  role            MembershipRole
  tokenHash       String         @unique @map("token_hash")
  invitedByUserId String?        @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime       @map("expires_at")
  acceptedAt      DateTime?      @map("accepted_at")
  revokedAt       DateTime?      @map("revoked_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  clinic    Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  invitedBy User?  @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
  @@map("staff_invitations")
}

// ---------------------------------------------------------------------------
// Platform (Phase 10)
// ---------------------------------------------------------------------------

model Plan {
  id                String  @id @default(uuid(7)) @db.Uuid
  code              String  @unique
  name              String
  // Smallest currency unit, e.g. paise for INR.
  priceMonthlyMinor Int     @map("price_monthly_minor")
  currency          String  @default("INR") @db.VarChar(3)
  // Null means no limit.
  maxStaff          Int?    @map("max_staff")
  maxServices       Int?    @map("max_services")
  isActive          Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

// Assumption: platform admins manage subscriptions by hand until a payment
// provider is chosen; there is no payment integration yet.
model Subscription {
  id               String             @id @default(uuid(7)) @db.Uuid
  clinicId         String             @unique @map("clinic_id") @db.Uuid
  planId           String             @map("plan_id") @db.Uuid
  status           SubscriptionStatus @default(TRIALING)
  trialEndsAt      DateTime?          @map("trial_ends_at")
  currentPeriodEnd DateTime?          @map("current_period_end")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([status])
  @@map("subscriptions")
}

model SupportTicket {
  id              String              @id @default(uuid(7)) @db.Uuid
  clinicId        String?             @map("clinic_id") @db.Uuid
  createdByUserId String?             @map("created_by_user_id") @db.Uuid
  subject         String              @db.VarChar(160)
  body            String
  status          SupportTicketStatus @default(OPEN)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic    Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  createdBy User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("support_tickets")
}

// Super admin actions. Clinic-level actions stay in audit_events.
model PlatformAuditEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  // Dotted verb, e.g. "clinic.suspended", "subscription.updated".
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("platform_audit_events")
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ---------------------------------------------------------------------------
// Messaging between patients and staff (docs/MESSAGING.md)
// ---------------------------------------------------------------------------

// Who the patient is talking to. Each token has at most one conversation
// per channel, and they are separate: doctors never see the reception chat
// and reception never sees the doctor chat (except the fallback below).
enum ConversationChannel {
  // Reception desk: receptionists and clinic admins.
  RECEPTION
  // The doctor. Who answers follows the visit (src/features/messaging/access.ts):
  // the doctor who started the consultation; before that, the doctors who
  // serve the token's service; reception when no doctor serves it.
  DOCTOR
}

enum MessageSender {
  PATIENT
  STAFF
}

enum BroadcastStatus {
  SENDING
  DONE
}

enum BroadcastRecipientStatus {
  PENDING
  SENT
  // Left out when its turn came, e.g. the visit had ended (skip_reason).
  SKIPPED
  // Gave up after repeated errors (last_error).
  FAILED
}

// One private chat between a patient's visit (token) and one side of the
// clinic. Created on the first message. Closing is computed from the token
// (read-only 2 hours after the visit ends), so there is no closed flag.
model Conversation {
  id       String              @id @default(uuid(7)) @db.Uuid
  clinicId String              @map("clinic_id") @db.Uuid
  tokenId  String              @map("token_id") @db.Uuid
  channel  ConversationChannel

  lastMessageAt   DateTime? @map("last_message_at")
  // Messages the other side hasn't read yet; reset to 0 when it reads.
  unreadByStaff   Int       @default(0) @map("unread_by_staff")
  unreadByPatient Int       @default(0) @map("unread_by_patient")
  // When each side last read the chat: a message is "seen" once the other
  // side's read time is at or after it.
  staffReadAt     DateTime? @map("staff_read_at")
  patientReadAt   DateTime? @map("patient_read_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic              Clinic               @relation(fields: [clinicId], references: [id])
  token               QueueToken           @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  messages            Message[]
  broadcastRecipients BroadcastRecipient[]

  @@unique([tokenId, channel])
  @@index([clinicId, channel, lastMessageAt])
  @@map("conversations")
}

// Text only, at most 1,000 characters. Rendered as plain text, never HTML.
model Message {
  id              String        @id @default(uuid(7)) @db.Uuid
  conversationId  String        @map("conversation_id") @db.Uuid
  clinicId        String        @map("clinic_id") @db.Uuid
  sender          MessageSender
  // The staff member who wrote it; null for patient messages.
  senderUserId    String?       @map("sender_user_id") @db.Uuid
  body            String        @db.VarChar(1000)
  // Chosen by the sending screen (a UUID), so a retried send returns the
  // stored message instead of adding a copy. Announcements use
  // "announcement:<broadcastId>".
  clientMessageId String        @map("client_message_id") @db.VarChar(64)
  broadcastId     String?       @map("broadcast_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  clinic       Clinic       @relation(fields: [clinicId], references: [id])
  senderUser   User?        @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  broadcast    Broadcast?   @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([clinicId, createdAt])
  @@map("messages")
}

// An announcement: one text sent as a separate private message into each
// recipient's reception chat. Recipients are fixed when it is created.
model Broadcast {
  id              String          @id @default(uuid(7)) @db.Uuid
  clinicId        String          @map("clinic_id") @db.Uuid
  createdByUserId String?         @map("created_by_user_id") @db.Uuid
  body            String          @db.VarChar(1000)
  // Services it went to; empty means every service.
  serviceIds      String[]        @map("service_ids") @db.Uuid
  status          BroadcastStatus @default(SENDING)
  totalRecipients Int             @map("total_recipients")
  // From the sending screen, so a double click creates one announcement.
  idempotencyKey  String          @map("idempotency_key") @db.VarChar(128)
  createdAt       DateTime        @default(now()) @map("created_at")
  completedAt     DateTime?       @map("completed_at")

  clinic     Clinic               @relation(fields: [clinicId], references: [id])
  createdBy  User?                @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  recipients BroadcastRecipient[]
  messages   Message[]

  @@unique([clinicId, idempotencyKey])
  @@index([clinicId, createdAt])
  @@map("broadcasts")
}

// One patient (token) of an announcement, and what happened for them. The
// rows are the work queue: PENDING rows are processed in small batches and
// picked up again after a crash.
model BroadcastRecipient {
  id             String                   @id @default(uuid(7)) @db.Uuid
  broadcastId    String                   @map("broadcast_id") @db.Uuid
  tokenId        String                   @map("token_id") @db.Uuid
  status         BroadcastRecipientStatus @default(PENDING)
  conversationId String?                  @map("conversation_id") @db.Uuid
  messageId      String?                  @map("message_id") @db.Uuid
  // Why the patient was left out, e.g. "VISIT_ENDED".
  skipReason     String?                  @map("skip_reason") @db.VarChar(40)
  attempts       Int                      @default(0)
  lastError      String?                  @map("last_error") @db.VarChar(300)
  processedAt    DateTime?                @map("processed_at")

  broadcast    Broadcast     @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  token        QueueToken    @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([broadcastId, tokenId])
  @@index([broadcastId, status])
  @@map("broadcast_recipients")
}
