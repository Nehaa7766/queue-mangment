# Copy to .env for values the containers should share.
# docker-compose.yml already sets DATABASE_URL and TEST_DATABASE_URL for the
# containers. The values below only apply to commands run on the host.
DATABASE_URL="postgresql://queuecare:queuecare@localhost:5442/queuecare_dev"
TEST_DATABASE_URL="postgresql://queuecare:queuecare@localhost:5442/queuecare_test"

# Authentication (Better Auth). docker-compose.yml sets development values.
# Use a long random secret in production: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Protects /api/internal/* job endpoints (outbox worker, data retention).
# INTERNAL_JOB_SECRET="replace-with-at-least-32-random-characters"

# Email (Resend). Without a key, development captures mail in memory and
# production refuses to send. EMAIL_FROM is required with a key and must use a
# domain verified with Resend. Never commit real keys.
# RESEND_API_KEY="your_resend_api_key"
# EMAIL_FROM="QueueCare <notifications@your-verified-domain.com>"
